  "example_automations": [
    {
      "id": "automation_1",
      "business_id": "business_1",
      "name": "Daily Sales Report",
      "enabled": true,
      "schedule": "Every day at 9:00 AM",
      "trigger": {
        "type": "schedule",
        "time": "09:00",
        "frequency": "daily"
      },
      "actions": [
        {
          "type": "data_pull",
          "service": "stripe",
          "data": "sales"
        },
        {
          "type": "data_pull",
          "service": "square",
          "data": "orders"
        },
        {
          "type": "email",
          "service": "mailchimp",
          "template": "daily_report"
        }
      ]
    },
    {
      "id": "automation_2",
      "business_id": "business_1",
      "name": "High-Value Customer Alert",
      "enabled": true,
      "schedule": "Real-time",
      "trigger": {
        "type": "webhook",
        "service": "stripe",
        "event": "payment.received"
      },
      "condition": {
        "field": "amount",
        "operator": "greater_than",
        "value": 100
      },
      "actions_if_true": [
        {
          "type": "email",
          "service": "mailchimp",
          "template": "thank_you"
        },
        {
          "type": "social_post",
          "service": "instagram",
          "template": "customer_shoutout"
        }
      ],
      "actions_if_false": [
        {
          "type": "sms",
          "service": "twilio",
          "template": "receipt"
        }
      ]
    },
    {
      "id": "automation_3",
      "business_id": "business_1",
      "name": "Instagram to Facebook Sync",
      "enabled": false,
      "schedule": "Real-time",
      "trigger": {
        "type": "webhook",
        "service": "instagram",
        "event": "post.created"
      },
      "actions": [
        {
          "type": "social_post",
          "service": "facebook",
          "template": "cross_post"
        }
      ]
    }
  ],

  "automation_templates": [
    {
      "id": "template_high_value",
      "name": "High-Value Customer Alert",
      "category": "sales",
      "popular": true,
      "description": "Get notified when customers make large purchases so you can send personalized thank you messages.",
      "trigger": "Stripe payment",
