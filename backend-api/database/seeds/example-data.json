    },
    {
      "id": "template_daily_sales",
      "name": "Daily Sales Report",
      "category": "sales",
      "description": "Receive a daily summary of your sales from Stripe and Square delivered to your inbox every morning.",
      "trigger": "Daily at 9:00 AM",
      "actions": ["Pull Stripe data", "Pull Square data", "Email report"]
    },
    {
      "id": "template_cross_post",
      "name": "Social Media Cross-Post",
      "category": "marketing",
      "popular": true,
      "description": "Automatically share your Instagram posts to Facebook to maximize your social media reach.",
      "trigger": "New Instagram post",
      "actions": ["Share to Facebook page"]
    },
    {
      "id": "template_review_request",
      "name": "Review Request After Purchase",
      "category": "customer",
      "description": "Ask customers for reviews 3 days after their purchase to collect feedback and testimonials.",
      "trigger": "Purchase complete",
      "actions": ["Wait 3 days", "Send review request email"]
    }
  ]
